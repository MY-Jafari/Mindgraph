{
  "name": "mindgraph",
  "private": true,
  "version": "1.0.0",
  "description": "Personal Mind Tree & Database Schema Designer",
  "author": "MY-Jafari",
  "homepage": "https://github.com/MY-Jafari/Mindgraph",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "tsc && vite build --mode desktop",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "desktop:pack": "npm run build:desktop && electron-builder --win --publish never",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/vazirmatn": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@xyflow/react": "^12.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "html-to-image": "^1.11.13",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "shiki": "^4.5.0",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "tinypool": "^2.2.0",
    "vite": "^6.4.5"
  }
}
